# ---------------------------------------------------------------------------
# Common (both modes)
# ---------------------------------------------------------------------------
# Note: the dashboard requires no database configuration. Per-minute counts
# are kept in memory (reset on restart or connection switch); the OEE panel
# connects to a line's `oee` database at runtime from the UI. The dashboard's
# MCP server (see below) is the one exception: its get_latest_oee tool reads
# OEE_DATABASE_URL directly, independent of the UI-connected OEE database.

# Dashboard HTTP server
HOST=127.0.0.1
PORT=8000

# How the dashboard gets data: 'direct' (S7 read from the configured PLC)
# or 'mqtt' (subscribe to a broker whose address is typed in the dashboard
# UI; until an address is submitted the dashboard shows "connecting").
# Default: direct.
# DATA_SOURCE=direct

# ---------------------------------------------------------------------------
# Direct mode (current single-line behaviour)
# ---------------------------------------------------------------------------
# PLC connection (S7-1200 via PUT/GET, read-only). Shared by the dashboard
# (direct mode) and the OEE recorder.
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1
POLL_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# OEE recorder (line PC only; `python -m app.recorder`)
# ---------------------------------------------------------------------------
# Local PostgreSQL database the recorder writes OEE history rows to.
# Also read by the dashboard process for the MCP server's get_latest_oee
# tool; if unset for the dashboard, the MCP OEE tool reports "not configured"
# (everything else works unchanged).
OEE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oee
# Seconds between persisted OEE rows. Default 1.
# OEE_WRITE_INTERVAL_S=1
# Ideal Cycle Time (seconds) used in the Performance calculation. Default 5.
# IDEAL_CYCLE_TIME_S=5

# ---------------------------------------------------------------------------
# Line PC only (broker + publisher; not used by the dashboard)
# ---------------------------------------------------------------------------
# Broker listen port (scripts/run_broker.py). Default 1883.
# BROKER_PORT=1883
# Publisher: broker to publish to (app/publisher.py). Defaults to 127.0.0.1:1883.
# BROKER_HOST=127.0.0.1
