# ---------------------------------------------------------------------------
# Common (both modes)
# ---------------------------------------------------------------------------
# PostgreSQL (local dev credentials supplied by the user)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plc_dashboard

# Dashboard HTTP server
HOST=127.0.0.1
PORT=8000

# How the dashboard gets data: 'direct' (S7 read from the configured PLC)
# or 'mqtt' (subscribe to the selected line's broker). Default: direct.
# DATA_SOURCE=direct

# ---------------------------------------------------------------------------
# Direct mode (current single-line behaviour)
# ---------------------------------------------------------------------------
# PLC connection (S7-1200 via PUT/GET, read-only)
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1
POLL_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# MQTT mode (multi-line)
# ---------------------------------------------------------------------------
# Default/selected line's broker (line identity = the line's PLC IP).
# MQTT_BROKER_HOST=192.168.0.11
# MQTT_BROKER_PORT=1883

# Optional registry of known lines for the dashboard dropdown:
# PLC_IP=broker_host:broker_port,PLC_IP=broker_host:broker_port
# LINES=192.168.0.1=192.168.0.11:1883,192.168.0.2=192.168.0.12:1883

# ---------------------------------------------------------------------------
# Line PC only (broker + publisher; not used by the dashboard)
# ---------------------------------------------------------------------------
# Broker listen port (scripts/run_broker.py). Default 1883.
# BROKER_PORT=1883
# Publisher: broker to publish to (app/publisher.py). Defaults to 127.0.0.1:1883.
# BROKER_HOST=127.0.0.1
